QDRANT_API_KEY=your_qdrant_api_key
QDRANT_URL=your_qdrant_url
PYTHON_ENV=development
PYTHON_PORT=8000

BACKEND_URL=http://localhost:3000

LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=LMS-RAG-SERVICE
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
# Embeddings: development uses Ollama on the host, production uses Gemini.
# nomic-embed-text is 768 dims (Chroma); gemini-embedding-001 is 3072 (Qdrant).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Storage provider: aws | azure | localstack
STORAGE_PROVIDER=aws
STORAGE_CONTAINER=your_storage_container
STORAGE_REGION=ap-south-1
# Credentials for aws/localstack
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
# STORAGE_ENDPOINT=http://localhost:4566
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# Azure storage (used when STORAGE_PROVIDER=azure)
# STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# STORAGE_ACCOUNT_NAME=your_storage_account
# STORAGE_ACCOUNT_KEY=your_storage_account_key

