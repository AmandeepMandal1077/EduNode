PORT=3000
NODE_ENV=development

# Local Docker Compose default. Replace for Atlas or another database.
MONGO_URI=mongodb://mongodb:27017/LMS?replicaSet=rs0&directConnection=true

JWT_SECRET=your_jwt_secret_key

RESETPASSWORDTOKENEXPIRY=3600000 # 60min in milliseconds

# Storage provider: aws | azure | localstack
STORAGE_PROVIDER=aws
STORAGE_CONTAINER=your_storage_container
STORAGE_REGION=your_storage_region
# Credentials for aws/localstack
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
# Optional S3-compatible endpoint used by the server (LocalStack)
# STORAGE_ENDPOINT=http://localhost:4566
# Endpoint used in signed upload URLs, reachable by the browser (LocalStack)
# STORAGE_PRESIGN_ENDPOINT=http://localhost:4566
# Public base URL stored in links (CDN/proxy/LocalStack)
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# Azure credentials (used only when STORAGE_PROVIDER=azure)
# STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# STORAGE_ACCOUNT_NAME=your_storage_account
# STORAGE_ACCOUNT_KEY=your_storage_account_key

INTERNAL_API_SECRET=your_internal_api_secret

STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

REDIS_HOST_NAME=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

CACHE_CONTENT_EXPIRATION_DUR=600000 # 10min in milliseconds

FRONTEND_URL=http://localhost:5173
RAG_SERVER_URL=http://localhost:8000

SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password